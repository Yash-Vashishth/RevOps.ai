# --- Razorpay Testbed Credentials ---
# Get these from https://dashboard.razorpay.com/app/keys (switch to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Database ---
# Defaults to local SQLite. Swap for a Postgres URL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/revops_ai
DATABASE_URL=sqlite:///./revops.db

# --- LLM Provider ---
# Choose one: "anthropic" or "openai"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- App Config ---
APP_ENV=development
LOG_LEVEL=INFO
